# Surakshya backend for /api/surakshya/* (local dev default: http://localhost:3000).
# Production (Vercel): set to your deployed API host, e.g. https://surakshya.onrender.com
SURAKSHYA_API_URL=http://localhost:3000

# Socket.IO connects directly to the backend (not via Next.js rewrites).
# Must match SURAKSHYA_API_URL in production. Do not append /tracking.
# Production (Vercel): e.g. https://surakshya.onrender.com
NEXT_PUBLIC_SURAKSHYA_WS_URL=http://localhost:3000

# Google Maps JavaScript API key for Places autocomplete (admin address fields).
# Restrict in Google Cloud Console to HTTP referrers:
#   - http://localhost:3002/*
#   - your production admin domain (e.g. https://your-app.vercel.app/*)
# Restrict API access to only:
#   - Maps JavaScript API
#   - Places API (New)
# Do not enable other APIs on this key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
