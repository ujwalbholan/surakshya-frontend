# AMS backend origin for /api/ams/* proxy (see next.config.ts rewrites).
# Used for public signup only. Police login and dashboard use /api/surakshya.
API_URL=https://ams-omwj.onrender.com

# Surakshya backend for /api/surakshya/* (local dev default: http://localhost:3000).
# Set to https://surakshya.onrender.com for production-like testing without a local backend.
SURAKSHYA_API_URL=http://localhost:3000
